# --- LLM (Groq) ---  REQUIRED
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Bonus: founder LinkedIn lookup ---  OPTIONAL (pick one)
# Tavily: https://tavily.com   |   SerpAPI: https://serpapi.com
TAVILY_API_KEY=
SERPAPI_KEY=

# --- Crawling behavior (optional overrides) ---
MAX_SUBPAGES=5
PAGE_TIMEOUT_MS=20000
MAX_CHARS_PER_PAGE=6000
MAX_TOTAL_CONTEXT_CHARS=20000
